# ========================================================
# LangGraph Workflow Workshop - Environment Configuration
# ========================================================
# INSTRUCTIONS FOR STUDENTS:
# 1. Copy this file and rename it to ".env" (without .example)
# 2. Fill in your actual values from Azure AI Foundry
# 3. NEVER commit the .env file to version control!
# ========================================================

# --------------------------------------------------------
# Azure AI Foundry Configuration (REQUIRED)
# --------------------------------------------------------
# Your Azure AI Foundry endpoint URL
# Find this in: Azure AI Foundry > Your Project > Settings
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<project-id>
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project-id

# Your Azure AI Agent ID
# Find this in: Azure AI Foundry > Your Project > Agents
# Create an agent in the portal or use the previous tasks
AZURE_OPENAI_AGENT_ID=your-agent-id-here

# --------------------------------------------------------



