# ========================================================
# Azure AI Workshop - Environment Configuration Template
# ========================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env" (without .example)
# 2. Fill in your actual values from Azure Portal
# 3. NEVER commit the .env file to version control!
# 4. The .env file should be in your .gitignore
# ========================================================

# --------------------------------------------------------
# Azure OpenAI Configuration
# --------------------------------------------------------
# Your Azure OpenAI endpoint URL
# Find this in: Azure Portal > Your OpenAI Resource > Keys and Endpoint
# Format: https://<your-resource-name>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1

# Your Azure OpenAI API Key (for API Key authentication method)
# Find this in: Azure Portal > Your OpenAI Resource > Keys and Endpoint
# WARNING: Keep this secret! Never share or commit this key.
AZURE_OPENAI_API_KEY=your-api-key-here

# Your deployed model name (e.g., gpt-4.1-mini, gpt-4o)
# This is the deployment name you created in Azure OpenAI Studio
AZURE_OPENAI_MODEL=gpt-4.1-mini

# --------------------------------------------------------
# Azure AI Foundry / Project Configuration
# --------------------------------------------------------
# Your Azure AI Project endpoint URL
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project-id

# Your Azure AI Agent ID (optional, if using pre-created agents)
# Find this in: Azure AI Foundry > Your Project > Agents
AZURE_AI_AGENT_ID=your-agent-id-here

