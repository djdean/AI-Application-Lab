# ========================================================
# Azure AI Agents Workshop - Environment Configuration
# ========================================================
# INSTRUCTIONS FOR STUDENTS:
# 1. Copy this file and rename it to ".env" (without .example)
# 2. Fill in your actual values from Azure AI Foundry
# 3. NEVER commit the .env file to version control!
# 4. The .env file should be in your .gitignore
# ========================================================

# --------------------------------------------------------
# Azure AI Foundry Configuration
# --------------------------------------------------------
# Your Azure AI Project endpoint URL (REQUIRED)
# Find this in: Azure AI Foundry > Your Project > Settings
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project-id

# Your Azure AI Agent ID (REQUIRED for Task 3)
# You can create an agent in the portal or use Task 2 to create one programmatically
AZURE_AI_AGENT_ID=your-agent-id-here

# Your deployed model name (REQUIRED for Task 2 - Creating Agents)
# This is the deployment name you created in Azure AI Foundry
# Common values: gpt-4.1-mini, gpt-4o
AZURE_OPENAI_MODEL=gpt-4.1-mini

