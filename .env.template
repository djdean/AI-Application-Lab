# ============================================================================
#                         ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`
# 2. Fill in your credentials and configuration values below
# 3. Never commit the `.env` file to version control (it's in .gitignore)
#
# HOW TO GET YOUR CREDENTIALS:
# - Azure Portal: https://portal.azure.com
# - Azure AI Foundry: https://ai.azure.com
# - OpenAI Platform: https://platform.openai.com
#
# ============================================================================

# ============================================================================
# AZURE AI PROJECT (Required for AI Agents)
# ============================================================================
# Get this from Azure AI Foundry > Your Project > Overview > Endpoint
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_PROJECT_ENDPOINT=""

# Model deployment name (e.g., gpt-4o, gpt-4o-mini)
# Get this from Azure AI Foundry > Deployments
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4o"

# ============================================================================
# AZURE OPENAI (Required for OpenAI-based features)
# ============================================================================
# Get these from Azure Portal > Azure OpenAI resource > Keys and Endpoint

# Azure OpenAI service endpoint
# Format: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=""

# Azure OpenAI API key (use Key 1 or Key 2 from Azure Portal)
AZURE_OPENAI_KEY=""
AZURE_OPENAI_API_KEY=""

# Deployment names (create these in Azure AI Foundry > Deployments)
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-4o"
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME="gpt-4o"
AZURE_OPENAI_ADA002_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# ============================================================================
# OPENAI (Optional - only if using OpenAI directly instead of Azure OpenAI)
# ============================================================================
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL_ID=""
OPENAI_RESPONSES_MODEL_ID=""

# ============================================================================
# AZURE AI SEARCH (Required for RAG/Search features)
# ============================================================================
# Get these from Azure Portal > Azure AI Search resource > Keys

# Azure AI Search service endpoint
# Format: https://<search-service-name>.search.windows.net
AZURE_AI_SERVICES_ENDPOINT=""

# Azure AI Search admin API key
AZURE_AI_SERVICES_KEY=""

# Search index name (create this via code or Azure Portal)
AZURE_AI_INDEX_NAME="student-loan-guide-index"

# ============================================================================
# AZURE BLOB STORAGE (Required for document storage)
# ============================================================================
# Get these from Azure Portal > Storage Account > Access Keys

# Storage account name
AZURE_STORAGE_ACCOUNT=""

# Connection string (from Access Keys > Connection string)
# Enclose in quotes as it contains special characters
BLOB_CONNECTION_STRING=""

# Blob container name for storing documents
BLOB_CONTAINER_NAME="content"


# ============================================================================
# NOTES:
# ============================================================================
# - All values with "" are required or recommended
# - Values with empty quotes "" need to be filled in
# - Never share or commit your actual credentials
# - Rotate keys periodically for security
# - Use Azure Key Vault for production deployments
# ============================================================================
